# Server-side settings for docker-compose.prod.yml. On the VM this file is ~/flowsense/.env.
# The deploy workflow creates it automatically (with random secrets) on the first deploy,
# so you only need this if you want to set the values yourself. Never commit the real .env.

# Shared secret between Node-RED and the backend's /api/ingest. Generate with: openssl rand -hex 24
INGEST_TOKEN=CHANGE_ME

# Encrypts credentials stored in Node-RED flows. Generate with: openssl rand -hex 24
NODE_RED_CREDENTIAL_SECRET=CHANGE_ME

# Public port of the dashboard. Vevora uses 80/443 on the same VM, so FlowSense uses 8080.
DASHBOARD_PORT=8080

# Set by CI on every deploy; only needed when running compose by hand on the VM.
REGISTRY=ghcr.io
IMAGE_OWNER=anasslamaalam
IMAGE_TAG=latest
